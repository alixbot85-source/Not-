# ─────────────────────────────────────────────────────────────
#  پنل مدیریت اکانت‌های ایتا — نمونهٔ پیکربندی
#  این فایل را به .env کپی کنید. فایل .env در .gitignore است.
# ─────────────────────────────────────────────────────────────

# ── الزامی ───────────────────────────────────────────────────
# توکن ربات تلگرام (از @BotFather)
# ⚠️ اینجا توکن واقعی ننویسید! این فایل داخل گیت commit می‌شود.
#    توکن واقعی فقط در فایل .env (که در .gitignore است) قرار می‌گیرد:
#        cp .env.example .env   و سپس .env را ویرایش کنید
BOT_TOKEN=123456:ABC-DEF...

# شناسهٔ عددی ادمین‌ها، جداشده با کاما. فقط این افراد به پنل دسترسی دارند.
ADMIN_IDS=11111111,22222222

# ── امنیت ────────────────────────────────────────────────────
# کلید Fernet برای رمزنگاری توکن/Session اکانت‌ها در دیتابیس.
# اگر خالی بماند، یک کلید ساخته و در data/secret.key با دسترسی 600 ذخیره می‌شود.
# ساخت دستی:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=

# ── مسیرها ───────────────────────────────────────────────────
DATA_DIR=data
LOG_DIR=logs
EXPORT_DIR=exports
# مسیر فونت فارسی برای خروجی PDF (TTF). اگر نباشد PDF غیرفعال و صادقانه گزارش می‌شود.
PERSIAN_FONT_PATH=assets/fonts/Vazirmatn-Regular.ttf

# ── رفتار عملیات ─────────────────────────────────────────────
# تأخیر بین هر عملیات (ثانیه) برای کاهش احتمال Flood
JOIN_DELAY=4.0
SEND_DELAY=2.5
# حداکثر تلاش مجدد و backoff
MAX_RETRIES=3
RETRY_BACKOFF=2.0
# حداقل فاصلهٔ بین دو ویرایش پیام Progress (ثانیه) — محدودیت واقعی Bot API
PROGRESS_EDIT_INTERVAL=3.0
# اندازهٔ صفحه در لیست‌ها
PAGE_SIZE=8

# ── Rate limit پنل تلگرام ────────────────────────────────────
RATE_LIMIT_EVENTS=20
RATE_LIMIT_WINDOW=10

# ── لینکدونی‌های پیش‌فرض ─────────────────────────────────────
# آدرس‌های کامل، جداشده با کاما. هنگام اولین اجرا در دیتابیس درج می‌شوند.
DEFAULT_LINKDONI=https://eitaa.com/linkdoni,https://eitaa.com/goroh_yab

# ── لایهٔ AI (اختیاری — EXTERNAL SERVICE REQUIRED) ───────────
# بدون این مقادیر، منوی AI با وضعیت «پیکربندی نشده» نمایش داده می‌شود و هرگز شبیه‌سازی نمی‌کند.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── لاگ ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── پل MTProto ایتا (اختیاری — برای «ورود با شمارهٔ تلفن») ────
# ورود با شماره به کلاینت واقعی MTProto نیاز دارد. سرویس EitaaBun این
# کار را انجام می‌دهد و یک HTTP API محلی در اختیار پنل می‌گذارد.
#   curl -fsSL https://bun.sh/install | bash
#   git clone https://github.com/ghaemifard/EitaaBun
#   cd EitaaBun && bun install && bun run index.ts
# تا وقتی این مقدار خالی باشد، «ورود با شماره» با پیام صریح غیرفعال است.
EITAA_BRIDGE_URL=

# ── پراکسی برای دسترسی به تلگرام (اختیاری) ───────────────────
# اگر api.telegram.org روی شبکهٔ شما مسدود است، آدرس پراکسی را بگذارید.
# نمونه‌ها:
#   TELEGRAM_PROXY=socks5://127.0.0.1:10808
#   TELEGRAM_PROXY=http://127.0.0.1:8080
TELEGRAM_PROXY=
